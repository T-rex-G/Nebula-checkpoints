# Local development only. Never commit real values.
NODE_ENV=development
PORT=10000
SESSION_SECRET=
# Example production key ID: alpha17-snapshot-2026-08. Keep empty locally so
# the development fallback cannot be paired accidentally with an empty secret.
NV_SNAPSHOT_SIGNING_KEY_ID=
NV_SNAPSHOT_SIGNING_SECRET=
# Optional JSON object of retired key IDs to secrets, retained only until all
# snapshots signed by those IDs expire.
NV_SNAPSHOT_RETIRED_KEYS_JSON=
# Optional JSON array for pre-migration bare HMAC signatures. Remove each old
# SESSION_SECRET after every legacy snapshot it signed has expired.
NV_SNAPSHOT_LEGACY_KEYS_JSON=

# Trusted operator-workstation inputs for the final public-alpha evidence gate.
# Populate these only from the separately reviewed activation record and trusted
# Ed25519 public key; never copy values out of the evidence bundle being checked.
NV_PUBLIC_ALPHA_SUBJECT_SHA256=
NV_PUBLIC_ALPHA_SOURCE_COMMIT=
NV_PUBLIC_ALPHA_GITHUB_TARGET_SHA256=
NV_PUBLIC_ALPHA_GITLAB_TARGET_SHA256=
NV_PUBLIC_ALPHA_GITEA_TARGET_SHA256=
NV_PUBLIC_ALPHA_HOSTED_TARGET_SHA256=
NV_ALPHA17_OPERATOR_KEY_ID=
NV_ALPHA17_OPERATOR_PUBLIC_KEY_BASE64=

# Existing Neon pooled PostgreSQL URL (optional for basic use; required for v5.2 live intelligence)
DATABASE_URL=

# Optional independent governance audit-chain secret. Keep stable once governance data exists.
# When empty, SESSION_SECRET is used as the source. Use at least 32 random bytes in production.
NV_GOVERNANCE_AUDIT_SECRET=

# Runtime behavior when active-policy evaluation cannot be completed.
# warn preserves existing writes with explicit warning evidence; block stops repository writes.
# Governance recovery/control-plane mutations remain non-blocking so a bad policy can be rolled back.
NV_GOVERNANCE_RUNTIME_FAILURE_MODE=warn

NV_DEPLOYMENT_PROFILE=hosted-alpha
NV_ALPHA_ACCESS_MODE=off
# Required only when NV_ALPHA_ACCESS_MODE=invite. Keep empty in this development template.
# Production invitation mode requires a stable secret of at least 32 bytes.
NV_ALPHA_INVITE_PEPPER=
NV_ALPHA_TERMS_VERSION=2026-07-29
NV_DATABASE_MIGRATION_MODE=apply
NV_BACKUP_KEY_BASE64=
NV_RESTORE_DATABASE_URL=
# Optional absolute trusted-CA file for pg/pg_dump/pg_restore. The protected
# Ubuntu qualification workflow pins the runner's system CA bundle explicitly.
PGSSLROOTCERT=
# Operator workstation only. Required to bind declared branch IDs to official
# Neon connection URIs before restore preview/destruction; unset it afterwards.
NEON_API_KEY=
# Copy project/branch IDs from the Neon console, preview the exact target with
# `node scripts/alpha-db.js restore-target`, review it out of band, then set the
# emitted fingerprint before a destructive isolated restore.
NV_COHORT_NEON_PROJECT_ID=
NV_COHORT_NEON_BRANCH_ID=
NV_RESTORE_NEON_PROJECT_ID=
NV_RESTORE_NEON_BRANCH_ID=
NV_RESTORE_TARGET_KIND=isolated-neon-branch
NV_RESTORE_TARGET_FINGERPRINT=
NV_MAINTENANCE_MODE=0

# Required on non-Render production hosting for GitHub webhook callbacks.
PUBLIC_BASE_URL=

# Hosted-alpha Free-plan envelope. Values may be lowered after measurement,
# but hosted production rejects values above these limits.
NV_EVENT_RETENTION_DAYS=30
NV_SESSION_RETENTION_DAYS=7
NV_LIVE_CLIENTS_PER_REPO=2
NV_LIVE_CLIENTS_TOTAL=10
NV_SNAPSHOT_RETENTION_COUNT=10
NV_SNAPSHOT_MANIFEST_MAX=5000
NV_GIT_DATA_MAX_MB=16
NV_NATIVE_PUSH_MAX_MB=16
NV_UPLOAD_MAX_MB=25
NV_UPLOAD_CONCURRENCY=1
NV_UPLOAD_TIMEOUT_MINUTES=10
NV_STALE_UPLOAD_HOURS=2
NV_GIT_HOST_ALLOWLIST=

# Optional upload YARA adapter for advanced/self-hosted deployments.
# Disabled by default; do not point this at untrusted or user-controlled rules.
NV_YARA_RULES_PATH=
NV_YARA_BIN=yara
NV_YARA_TIMEOUT_SECONDS=5
NV_REQUIRE_YARA=0

# Optional GitHub OAuth; PAT login works without these.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional GitHub App authentication. Leave every value empty to keep the feature disabled.
# Existing GitHub PAT/OAuth, GitLab, and Gitea login remain available.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Prefer base64 in hosted environment variables; set only one private-key form.
GITHUB_APP_PRIVATE_KEY_BASE64=
# Optional local alternative (PEM with literal \n line breaks):
# GITHUB_APP_PRIVATE_KEY=
# May be omitted when PUBLIC_BASE_URL is the canonical HTTPS origin.
GITHUB_APP_CALLBACK_URL=
# Reserved for verified GitHub App webhooks in a later task; optional in Task 2.
GITHUB_APP_WEBHOOK_SECRET=
